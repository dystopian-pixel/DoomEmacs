(let* ((dd (expand-file-name "~/.doom.d/"))
       (out (or (getenv "OUT")
                (expand-file-name "theme-gallery/live-css" dd)))
       (list-file (or (getenv "THEMES_FILE")
                      (expand-file-name "theme-list.txt" dd))))
  ;; add doom-themes to load-path (common Straight build locations)
  (dolist (dir (append (file-expand-wildcards "~/.emacs.d/.local/straight/build*/doom-themes")
                       (file-expand-wildcards "~/.emacs.d/straight/build*/doom-themes")))
    (when (and dir (file-directory-p dir))
      (add-to-list 'load-path dir)))
  (require 'doom-themes)
  (load-file (expand-file-name "generate-doom-css.el" dd))
  (unless (file-directory-p out) (make-directory out t))
  (with-temp-buffer
    (insert-file-contents list-file)
    (let ((themes (split-string (buffer-string) "\n" t)))
      (doom-export-themes-css themes out))))
